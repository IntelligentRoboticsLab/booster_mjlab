<mujoco model="goal">
    <compiler angle="radian" meshdir="assets" autolimits="true" />

    <asset>
        <material name="goal_white" rgba="1.0 1.0 1.0 1.0" />
        <mesh name="goal_mesh" file="goal_180_120.obj" />
    </asset>

    <default>
        <default class="goal_visual">
            <geom contype="0" conaffinity="0" group="2" />
        </default>
        <default class="goal_collision">
            <geom contype="1" conaffinity="1" group="3" />
        </default>
    </default>

    <worldbody>
        <body>
            <geom class="goal_visual" type="mesh" mesh="goal_mesh" material="goal_white" />

